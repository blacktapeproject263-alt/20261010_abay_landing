---
// CalModal.astro
---

<!-- Cal.com Fallback Floating Trigger or Modal -->
<div id="cal-modal-container" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
  <div class="relative w-full max-w-3xl bg-slate-900 border border-slate-700 rounded-3xl p-6 shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between pb-4 border-b border-slate-800">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
        <h3 class="text-lg font-bold text-white">Book a 15-Minute Discovery Call</h3>
      </div>
      <button id="close-cal-modal" class="p-2 rounded-lg text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="py-6 text-center space-y-4">
      <p class="text-slate-300 text-sm">
        Select a date and time that fits your timezone for an initial scoping call with Abay Syzdykov.
      </p>
      <div class="inline-block">
        <a 
          href="https://cal.com/abay-syzdykov/15min" 
          target="_blank" 
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm"
        >
          <span>Open Cal.com Scheduler in New Tab</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const setupCalModal = () => {
    const modal = document.getElementById('cal-modal-container');
    const closeBtn = document.getElementById('close-cal-modal');
    if (!modal || !closeBtn) return;

    closeBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  };

  setupCalModal();
  document.addEventListener('astro:after-swap', setupCalModal);
</script>
