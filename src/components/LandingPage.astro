---
// src/components/LandingPage.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import MetricsDashboard from '@/components/MetricsDashboard.astro';
import CaseStudies from '@/components/CaseStudies.astro';
import Certifications from '@/components/Certifications.astro';
import CoreSkills from '@/components/CoreSkills.astro';
import ContactForm from '@/components/ContactForm.astro';
import CalModal from '@/components/CalModal.astro';
import Footer from '@/components/Footer.astro';
import type { Locale } from '@/i18n/translations';
import { translations } from '@/i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<Layout 
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
>
  <Header lang={lang} />
  <main class="flex-grow">
    <Hero lang={lang} />
    <MetricsDashboard lang={lang} />
    <CaseStudies lang={lang} />
    <Certifications lang={lang} />
    <CoreSkills lang={lang} />
    <ContactForm lang={lang} />
    <CalModal lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
