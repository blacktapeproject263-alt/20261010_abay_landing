---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import MetricsDashboard from '@/components/MetricsDashboard.astro';
import CaseStudies from '@/components/CaseStudies.astro';
import CoreSkills from '@/components/CoreSkills.astro';
import ContactForm from '@/components/ContactForm.astro';
import CalModal from '@/components/CalModal.astro';
import Footer from '@/components/Footer.astro';

export const prerender = true;
---

<Layout 
  title="Abay Syzdykov | Data Analyst & BI Specialist"
  description="Senior Data Analyst & BI Specialist. Turning complex business telemetry into automated dashboards, revenue optimization, and board-ready insights."
>
  <Header />
  <main class="flex-grow">
    <Hero />
    <MetricsDashboard />
    <CaseStudies />
    <CoreSkills />
    <ContactForm />
    <CalModal />
  </main>
  <Footer />
</Layout>
